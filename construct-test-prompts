taset_ref = f\"{KAGGLE_USERNAME}/{dataset_name}\"\n    metadata_path = os.path.join(save_folder, \"dataset-metadata.json\")\n\n    # Initialize metadata if it does not exist\n    if not os.path.exists(metadata_path):\n        subprocess.run(\n            [\"kaggle\", \"datasets\", \"init\", \"-p\", save_folder],\n            check=True\n        )\n\n    # Read and update metadata\n    with open(metadata_path, \"r\", encoding=\"utf-8\") as f:\n        dataset_meta = json.load(f)\n\n    # Inject metadata directly into supported fields\n    dataset_meta[\"id\"] = dataset_ref\n    dataset_meta[\"title\"] = dataset_name\n    dataset_meta[\"description\"] = \"Experimental 3x4x7 prompt matrix for multi-language evaluation tasks.\"\n    dataset_meta[\"keywords\"] = [\"nlp\", \"code switching\", \"prompt engineering\", \"linguistics\"]\n\n    with open(metadata_path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(dataset_meta, f, ensure_ascii=False, indent=2)\n\n    # Check whether the dataset already exists\n    result = subprocess.run(\n        [\"kaggle\", \"datasets\", \"files\", dataset_ref],\n        capture_output=True,\n        text=True\n    )\n    \n    if result.returncode == 0:\n        print(f\"\\nDataset '{dataset_ref}' already exists. Updating...\")\n        subprocess.run(\n            [\"kaggle\", \"datasets\", \"version\", \"-p\", save_folder, \"-m\", \"Added generated prompt suites\"],\n            check=True\n        )\n        print(\"Kaggle dataset updated successfully.\")\n    else:\n        print(f\"\\nDataset '{dataset_ref}' does not exist. Creating...\")\n        subprocess.run(\n            [\"kaggle\", \"datasets\", \"create\", \"-p\", save_folder],\n            check=True\n        )\n        print(f\"Kaggle dataset created successfully:\\n/kaggle/input/datasets/{KAGGLE_USERNAME}/{dataset_name}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-16T21:41:13.252978Z","iopub.execute_input":"2026-09-16T21:41:13.253355Z","iopub.status.idle":"2026-09-16T21:41:13.269574Z","shell.execute_reply.started":"2026-09-16T21:41:13.253325Z","shell.execute_reply":"2026-09-16T21:41:13.268075Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def main() -> None:\n    parser = argparse.ArgumentParser(description=\"Build 3x3x7 experimental prompt matrix.\")\n    parser.add_argument(\n        \"--suite_dir\",\n        type=str,\n        default=\"suite\",\n        help=\"Directory containing extracted JSON suites\",\n    )\n    parser.add_argument(\n        \"--output_dir\",\n        type=str,\n        default=\"prompts\",\n        help=\"Output directory for prompts\",\n    )\n    args = parser.parse_args(args=['--suite_dir=/kaggle/input/datasets/ozlemkrblt/code-switching-test-data'])\n\n    os.makedirs(args.output_dir, exist_ok=True)\n\n    for task_name in [\"xnli\", \"xquad\", \"belebele\"]:\n        input_file = os.path.join(args.suite_dir, f\"{task_name}_suite.json\")\n\n        if not os.path.exists(input_file):\n            print(f\"File {input_file} not found. Skipping {task_name}.\")\n            continue\n\n        with open(input_file, \"r\", encoding=\"utf-8\") as f:\n            items = json.load(f)\n\n        all_prompts: List[Dict[str, Any]] = []\n        for item in items:\n            all_prompts.extend(build_prompts_for_item(item, task_name))\n\n        output_file = os.path.join(args.output_dir, f\"{task_name}_prompts.json\")\n        with open(output_file, \"w\", encoding=\"utf-8\") as f:\n            json.dump(all_prompts, f, ensure_ascii=False, indent=2)\n\n        print(f\"Generated {len(all_prompts)} prompts for {task_name} -> saved to '{output_file}'.\")\n    \n    setup_kaggle_auth()\n    create_or_update_kaggle_dataset(args.output_dir, PROMPTS_DATASET_NAME)\n\nif __name__ == \"__main__\":\n    main()","metadata":{"execution":{"iopub.status.busy":"2026-09-16T21:41:13.271306Z","iopub.execute_input":"2026-09-16T21:41:13.272545Z","iopub.status.idle":"2026-09-16