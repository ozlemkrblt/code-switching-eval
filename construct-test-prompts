1.416526+00:00","exception":false,"start_time":"2026-09-25T21:26:01.388893+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def build_prompts_for_item(item: Dict[str, Any], task_type: str, p_de: Any, p_en: Any, p_cm: Any) -> List[Dict[str, Any]]:\n","    prompt_variants: List[Dict[str, Any]] = []\n","\n","    tr = item[\"turkish\"]\n","    en = item[\"english\"] \n","    de = item[\"german\"] \n","\n","    input_conditions: Dict[str, Any] = {}\n","\n","    if task_type == \"xnli\":\n","        input_conditions = {\n","            \"C0\": (\n","                f\"Öncül: {tr['premise']}\\nHipotez: {tr['hypothesis']}\\n\"\n","                f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n","            ),\n","            \"Q-DE\": (\n","                f\"Öncül: {tr['premise']}\\nHipotez: {de['hypothesis']}\\n\"\n","                f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n","            ),\n","            \"Q-EN\": (\n","                f\"Öncül: {tr['premise']}\\nHipotez: {en['hypothesis']}\\n\"\n","                f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n","            ),\n","            \"H-DE\": [\n","                {\"role\": \"user\", \"content\": f\"{p_de.get('query', '')}\"},\n","                {\"role\": \"assistant\", \"content\": f\"{p_de.get('response', '')}\"},\n","                {\n","                    \"role\": \"user\",\n","                    \"content\": (\n","                        f\"Öncül: {tr['premise']}\\nHipotez: {tr['hypothesis']}\\n\"\n","                        f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n","                    ),\n","                },\n","            ],\n","            \"H-EN\": [\n","                {\"role\": \"user\", \"content\": f\"{p_en.get('query', '')}\"},\n","                {\"role\": \"assistant\", \"content\": f\"{p_en.get('response', '')}\"},\n","                {\n","                    \"role\": \"user\",\n","                    \"content\": (\n","                        f\"Öncül: {tr['premise']}\\nHipotez: {tr['hypothesis']}\\n\"\n","                        f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n","                    ),\n","                },\n","            ],\n","            \"Q-M\": (\n","                f\"Öncül: {en['premise']}\\nHipotez: {de['hypothesis']}\\n\"\n","                f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n","            ),\n","            \"H-M\": [\n","                { \"role\": \"user\", \"content\": f\"{p_cm.get('query', '')}\" },\n","                {\"role\": \"assistant\", \"content\": f\"{p_cm.get('response', '')}\"},\n","                {\n","                    \"role\": \"user\",\n","                    \"content\": (\n","                        f\"Öncül: {tr['premise']}\\nHipotez: {tr['hypothesis']}\\n\"\n","                        f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n","                    ),\n","                },\n","            ],\n","        }\n","    elif task_type in [\"xquad\", \"belebele\"]:\n","        ctx_tr = tr.get(\"context\") or tr.get(\"passage\")\n","        ctx_en = en.get(\"context\") or en.get(\"passage\")\n","        ctx_de = de.get(\"context\") or de.get(\"passage\")\n","        a_tr=\"\"\n","        a_en=\"\"\n","        a_de=\"\"\n","\n","        if task_type == \"belebele\":\n","            opts= [\"A\", \"B\", \"C\", \"D\"]\n","            def build_multichoice_questions(lang_data):\n","                options_text = \"\\n\".join([f\"{opts[i]}) {lang_data[f'mc_answer{i+1}']}\" for i in range(4)])\n","                return f\"{lang_data['question']}\\n{options_text}\"\n","            \n","            q_tr = build_multichoice_questions(tr)\n","            q_en = build_multichoice_questions(en)\n","            q_de = build_mul