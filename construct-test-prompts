ki Türkçe örnek yanıt tarzını takip et ve cevabını Türkçe olarak ver.\\n\\nÖrnek 1:\\nÖncül: Adam elma yiyor.\\nHipotez: Adam meyve yiyor.\\nSoru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt: destekliyor\\n\\nÖrnek 2:\\nÖncül: Köpek bahçede koşuyor.\\nHipotez: Kedi uyuyor.\\nSoru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt: nötr\\n\\nÖrnek 3:\\nÖncül: Gökyüzü mavi ve güneşli.\\nHipotez: Dışarıda şiddetli yağmur yağıyor.\\nSoru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt: çelişiyor\"\n    },\n    \"xquad\": {\n        \"zeroshot\": \"Metne dayanarak soruyu Türkçe olarak yanıtla.\",\n        \"oneshot\": \"Aşağıdaki Türkçe örnek yanıt tarzını takip et ve cevabını Türkçe olarak ver.\\n\\nÖrnek:\\nMetin: Türkiye'nin başkenti Ankara'dır ve İç Anadolu Bölgesi'nde yer alır.\\nSoru: Ankara hangi bölgededir?\\nYanıt: İç Anadolu Bölgesi\",\n        \"fewshot\": \"Aşağıdaki Türkçe örnek yanıt tarzını takip et ve cevabını Türkçe olarak ver.\\n\\nÖrnek 1:\\nMetin: Türkiye'nin başkenti Ankara'dır ve İç Anadolu Bölgesi'nde yer alır.\\nSoru: Ankara hangi bölgededir?\\nYanıt: İç Anadolu Bölgesi\\n\\nÖrnek 2:\\nMetin: Ay, Dünya'nın tek doğal uydusudur. Dünya'dan ortalama 384.400 kilometre uzaklıktadır.\\nSoru: Ay'ın Dünya'ya uzaklığı ne kadardır?\\nYanıt: 384.400 kilometre\"\n    },\n    \"belebele\": {\n        \"zeroshot\": \"Metne dayanarak soruyu Türkçe olarak yanıtla. Seçenekleri incele ve sadece doğru seçeneği (A, B, C veya D) metniyle birlikte yaz.\",\n        \"oneshot\": \"Aşağıdaki Türkçe örnek yanıt tarzını takip et ve cevabını Türkçe olarak ver.\\n\\nÖrnek:\\nMetin: Türkiye'nin başkenti Ankara'dır ve İç Anadolu Bölgesi'nde yer alır.\\nSoru: Ankara hangi bölgededir?\\nA) Marmara\\nB) Ege\\nC) İç Anadolu\\nD) Akdeniz\\nYanıt: C) İç Anadolu\",\n        \"fewshot\": \"Aşağıdaki Türkçe örnek yanıt tarzını takip et ve cevabını Türkçe olarak ver.\\n\\nÖrnek 1:\\nMetin: Türkiye'nin başkenti Ankara'dır ve İç Anadolu Bölgesi'nde yer alır.\\nSoru: Ankara hangi bölgededir?\\nA) Marmara\\nB) Ege\\nC) İç Anadolu\\nD) Akdeniz\\nYanıt: C) İç Anadolu\\n\\nÖrnek 2:\\nMetin: Ay, Dünya'nın tek doğal uydusudur. Dünya'dan ortalama 384.400 kilometre uzaklıktadır.\\nSoru: Ay'ın Dünya'ya uzaklığı ne kadardır?\\nA) 100.000 kilometre\\nB) 384.400 kilometre\\nC) 1 milyon kilometre\\nD) 500.000 kilometre\\nYanıt: B) 384.400 kilometre\"\n    }\n}\n#\"cot\": \"Yanıt vermeden önce adım adım Türkçe düşünerek akıl yürüt, ardından nihai cevabını CEVAP:[Cevap] formatında yaz Türkçe yaz.\"","metadata":{"execution":{"iopub.status.busy":"2026-09-28T23:35:02.637184Z","iopub.execute_input":"2026-09-28T23:35:02.637576Z","iopub.status.idle":"2026-09-28T23:35:02.646095Z","shell.execute_reply.started":"2026-09-28T23:35:02.637524Z","shell.execute_reply":"2026-09-28T23:35:02.644859Z"},"trusted":true},"outputs":[],"execution_count":3},{"cell_type":"code","source":"PROMPTS_DATASET_NAME = \"code-switching-prompts\"\nKAGGLE_USERNAME = \"ozlemkrblt\"\nKAGGLE_SECRET_NAME = \"my-secret\"","metadata":{"execution":{"iopub.status.busy":"2026-09-28T23:35:02.647297Z","iopub.execute_input":"2026-09-28T23:35:02.647659Z","iopub.status.idle":"2026-09-28T23:35:02.684291Z","shell.execute_reply.started":"2026-09-28T23:35:02.647628Z","shell.execute_reply":"2026-09-28T23:35:02.683188Z"},"trusted":true},"outputs":[],"execution_count":4},{"cell_type":"code","source":"def build_prompts_for_item(item: Dict[str, Any], task_type: str, p_de: Any, p_en: Any, p_cm: Any) -> List[Dict[str, Any]]:\n    prompt_variants: List[Dict[str, Any]] = []\n\n    tr = item[\"turkish\"]\n    en = item[\"english\"] \n    de = item[\"german\"] \n\n    input_conditions: Dict[str, Any] = {}\n\n    if task_type == \"xnli\":\n        input_conditions = {\n            \"C0\": (\n                f\"Öncül: {tr['premise']}\\nHipotez: {tr['hypothesis']}\\n\"\n                f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n            ),\n            \"Q-DE\": (\n                f\"Öncül: {tr['premise']}\\nHipotez: {de['hypothesis']}\\n\"\n                f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n            ),\n            \"Q-EN\": (\n                f\"Öncül: {tr['premise']}\\nHipotez: {en['hypothesis']}\\n\"\n                f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n            ),\n            \"H-DE\": [\n                {\"role\": \"user\", \"content\": f\"{p_de.get('query', '')}\"},\n                {\"role\": \"assistant\", \"content\": f\"{p_de.get('response', '')}\"},\n                {\n                    \"role\": \"user\",\n                    \"content\": (\n                        f\"Öncül: {tr['premise']}\\nHipotez: {tr['hypothesis']}\\n\"\n                        f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n                    ),\n                },\n            ],\n            \"H-EN\": [\n                {\"role\": \"user\", \"content\": f\"{p_en.get('query', '')}\"},\n                {\"role\": \"assistant\", \"content\": f\"{p_en.get('response', '')}\"},\n                {\n                    \"role\": \"user\",\n                    \"content\": (\n                        f\"Öncül: {tr['premise']}\\nHipotez: {tr['hypothesis']}\\n\"\n                        f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n                    ),\n                },\n            ],\n            \"Q-M\": (\n                f\"Öncül: {en['premise']}\\nHipotez: {de['hypothesis']}\\n\"\n                f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n            ),\n            \"H-M\": [\n                { \"role\": \"user\", \"content\": f\"{p_cm.get('query', '')}\" },\n                {\"role\": \"assistant\", \"content\": f\"{p_cm.get('response', '')}\"},\n                {\n                    \"role\": \"user\",\n                    \"content\": (\n                        f\"Öncül: {tr['premise']}\\nHipotez: {tr['hypothesis']}\\n\"\n                        f\"Soru: Öncül hipotezi destekliyor mu, çelişiyor mu yoksa nötr mü?\\nYanıt:\"\n                    ),\n                },\n            ],\n        }\n    elif task_type in [\"xquad\", \"belebele\"]:\n        ctx_tr = tr.get(\"context\") or tr.get(\"passage\")\n        ctx_en = en.get(\"context\") or en.get(\"passage\")\n        ctx_de = de.get(\"context\") or de.get(\"passage\")\n        a_tr=\"\"\n        a_en=\"\"\n        a_de=\"\"\n\n        if task_type == \"belebele\":\n            opts= [\"A\", \"B\", \"C\", \"D\"]\n            def build_multichoice_questions(lang_data):\n                options_text = \"\\n\".join([f\"{opts[i]}) {lang_data[f'mc_answer{i+1}']}\" for i in range(4)])\n                return f\"{lang_data['question']}\\n{options_text}\"\n            \n            q_tr = build_multichoice_questions(tr)\n            q_en = build_multichoice_questions(en)\n            q_de = build_multichoice_questions(de)\n            \n            correct_idx = int(item['correct_answer_num']) - 1\n            a_tr = f\"{opts[correct_idx]}) {tr[f'mc_answer{correct_idx+1}']}\"\n            a_en = f\"{opts[correct_idx]}) {en[f'mc_answer{correct_idx+1}']}\"\n            a_de = f\"{opts[correct_idx]}) {de[f'mc_answer{correct_idx+1}']}\"\n            \n        else:  # xquad\n            q_tr = tr[\"question\"]\n            q_en = en[\"question\"]\n            q_de = de[\"question\"]\n            \n            a_tr = tr[\"answers\"][0]\n            a_en = en[\"answers\"][0]\n            a_de = de[\"answers\"][0] \n\n        input_conditions = {\n            \"C0\": f\"Metin: {ctx_tr}\\nSoru: {q_tr}\\nYanıt:\",\n            \"Q-DE\": f\"Metin: {ctx_tr}\\nFrage: {q_de}\\nYanıt:\",\n            \"Q-EN\": f\"Metin: {ctx_tr}\\nQuestion: {q_en}\\nYanıt:\",\n            \"H-DE\": [\n                {\"role\": \"user\", \"content\": f\"{p_